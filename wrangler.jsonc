{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luloxdev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "luloxdev"
    }
  ],
  // Cloudflare D1: blog_posts, project_overrides and the Better Auth tables.
  // Secrets (wrangler secret put, never in this file): BETTER_AUTH_SECRET,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET. Locally they go in .dev.vars.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luloxdev",
      "database_id": "61d3b739-db00-4fed-86d5-0387bf50b2cc",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
