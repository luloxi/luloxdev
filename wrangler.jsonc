{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luloxdev",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "luloxdev"
    }
  ],
  // Cloudflare D1: blog_posts, project_overrides and the Better Auth tables.
  // Secrets (wrangler secret put, never in this file): BETTER_AUTH_SECRET,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET. Locally they go in .dev.vars.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luloxdev",
      "database_id": "61d3b739-db00-4fed-86d5-0387bf50b2cc",
      "migrations_dir": "migrations"
    }
  ],
  // Custom domains (Cloudflare zone lulox.dev). The apex is redirected to www
  // in worker.ts, matching the previous Vercel behaviour (307 to www).
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "www.lulox.dev", "custom_domain": true },
    { "pattern": "lulox.dev", "custom_domain": true }
  ],
  // Contact form: Email Routing send binding (lulox.com.ar, verified destination).
  // Recipient is provisional until a lulox.com.ar mailbox exists.
  "send_email": [
    { "name": "CONTACT_EMAIL", "destination_address": "lucianoolivabianco@gmail.com" }
  ],
  "ratelimits": [
    { "name": "CONTACT_RL", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  // TURNSTILE_SECRET is a Worker secret (never in this file).
  "vars": {
    "CONTACT_TO": "lucianoolivabianco@gmail.com",
    "CONTACT_FROM": "web@lulox.com.ar",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFYS_U1JH5j5qo8w"
  },
  "observability": {
    "enabled": true
  }
}
